{
  "name": "cartel-site",
  "version": "1.0.0",
  "private": true,
  "description": "CARTEL corporate website with modular CMS and HR module",
  "main": "server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "seed": "node scripts/seed.js",
    "create-admin": "node scripts/create-admin.js",
    "backup": "node scripts/backup.js",
    "test:security": "node --test --test-concurrency=1 tests/security.test.js",
    "test:e2e": "python3 tests/e2e_acceptance.py"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "better-sqlite3": "^13.2.0",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "leaflet": "^1.9.4",
    "multer": "^2.5.0",
    "nodemailer": "^10.6.1",
    "nunjucks": "^3.2.4",
    "qrcode": "^1.5.4",
    "sanitize-html": "^2.18.2",
    "sharp": "^0.35.5"
  }
