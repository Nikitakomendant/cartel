{% set st = data.stories() %}
{% if st.length %}
<section class="section section--tint" id="b-{{ bid }}">
  <div class="wrap">
    {% if t(d.title) %}<h2 class="display-m section__title">{{ t(d.title) }}</h2>{% endif %}
    <ul class="stories">
      {% for x in st %}
      <li class="story">
        {% if x.photo %}<div class="story__photo">{{ img(x.photo, {sizes: '(min-width: 900px) 20vw, 40vw', alt: t(x.name), lang: lang}) }}</div>{% endif %}
        <blockquote><p>{{ t(x.text) }}</p></blockquote>
        <p class="story__who"><strong>{{ t(x.name) }}</strong>{% if t(x.position) %}<span class="muted">{{ t(x.position) }}</span>{% endif %}</p>
      </li>
      {% endfor %}
    </ul>
  </div>
</section>
{% endif %}
