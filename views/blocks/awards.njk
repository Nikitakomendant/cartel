{% if d.items and d.items.length %}
<section class="section section--tint" id="b-{{ bid }}">
  <div class="wrap">
    {% if t(d.title) %}<h2 class="display-m section__title">{{ t(d.title) }}</h2>{% endif %}
    <ul class="awards">
      {% for it in d.items %}
      <li><span class="awards__year">{{ it.year }}</span><span class="awards__title">{{ t(it.title) }}</span><span class="awards__text muted">{{ t(it.text) }}</span></li>
      {% endfor %}
    </ul>
  </div>
</section>
{% endif %}
