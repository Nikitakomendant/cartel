<section class="section" id="b-{{ bid }}">
  <div class="wrap">
    {% if t(d.title) %}<h2 class="display-m section__title">{{ t(d.title) }}</h2>{% endif %}
    <figure class="video">
      {% if d.video and media(d.video) %}
        {{ ui.videoTag(d.video, d.poster, 'video__el', true) }}
      {% elif embedUrl(d.embed) %}
        <div class="video__embed" data-embed="{{ embedUrl(d.embed) }}">
          {% if d.poster %}{{ img(d.poster, {sizes: '100vw', alt: '', lang: lang}) }}{% endif %}
          <button type="button" class="video__play" data-embed-play><span>{{ s('common.play') }}</span></button>
        </div>
      {% endif %}
      {% if t(d.caption) %}<figcaption>{{ t(d.caption) }}</figcaption>{% endif %}
    </figure>
  </div>
</section>
