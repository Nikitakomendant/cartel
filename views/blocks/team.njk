{% set people = data.team() %}
{% if people.length %}
<section class="section" id="team">
  <div class="wrap">
    <div class="section__head">
      {% if t(d.title) %}<h2 class="display-m">{{ t(d.title) }}</h2>{% endif %}
      {% if t(d.intro) %}<p class="lead">{{ t(d.intro) }}</p>{% endif %}
    </div>
    <ul class="people">
      {% for p in people %}
      <li class="person">
        <div class="person__photo">{% if p.photo %}{{ img(p.photo, {sizes: '(min-width: 900px) 25vw, 50vw', alt: t(p.name), lang: lang}) }}{% endif %}</div>
        <h3 class="person__name">{{ t(p.name) }}</h3>
        {% if t(p.position) %}<p class="person__role">{{ t(p.position) }}</p>{% endif %}
        {% if t(p.bio) %}<p class="person__bio">{{ t(p.bio) }}</p>{% endif %}
      </li>
      {% endfor %}
    </ul>
  </div>
</section>
{% endif %}
