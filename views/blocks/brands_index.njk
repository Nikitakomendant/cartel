{% set list = data.brandsByIds(d.ids) %}
{% if list.length %}
<section class="section brand-index-wrap" id="b-{{ bid }}">
  <div class="wrap">
    <div class="section__head">
      {% if t(d.title) %}<h2 class="display-m">{{ t(d.title) }}</h2>{% endif %}
      {% if t(d.intro) %}<p class="lead">{{ t(d.intro) }}</p>{% endif %}
    </div>
    <div class="brand-index" data-brand-index>
      <ol class="brand-index__list">
        {% for b in list %}
        <li class="brand-index__row">
          <a href="{{ b.url }}" data-preview="{{ loop.index0 }}">
            <span class="brand-index__thumb" aria-hidden="true">{{ img(b.cardImage, {sizes: '96px', alt: '', lang: lang}) }}</span>
            <span class="brand-index__name">{{ t(b.name) }}</span>
            <span class="brand-index__meta">{{ s('cat.' + b.category) }}{% if t(b.city) %}, {{ t(b.city) }}{% endif %}</span>
          </a>
        </li>
        {% endfor %}
      </ol>
      <div class="brand-index__stage" aria-hidden="true">
        {% for b in list %}<div class="brand-index__frame" data-frame="{{ loop.index0 }}">{{ img(b.cardImage, {sizes: '40vw', alt: '', lang: lang}) }}</div>{% endfor %}
      </div>
    </div>
    {% if t(d.button_label) %}<p class="actions">{{ ui.btn(t(d.button_label), d.button_url, 'ghost') }}</p>{% endif %}
  </div>
</section>
{% endif %}
