<section class="section" id="b-{{ bid }}">
  <div class="wrap">
    {% if t(d.title) %}<h2 class="display-m section__title">{{ t(d.title) }}</h2>{% endif %}
    <ol class="timeline">
      {% for it in d.items %}
      <li class="timeline__item">
        <p class="timeline__year">{{ t(it.year) }}</p>
        <div class="timeline__body">
          <h3 class="timeline__title">{{ t(it.title) }}</h3>
          {% if t(it.text) %}<p>{{ t(it.text) | nl2br }}</p>{% endif %}
        </div>
        {% if it.image %}<div class="timeline__media">{{ img(it.image, {sizes: '(min-width: 900px) 25vw, 100vw', lang: lang}) }}</div>{% endif %}
      </li>
      {% endfor %}
    </ol>
  </div>
</section>
