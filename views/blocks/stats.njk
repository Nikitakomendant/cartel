<section class="section section--{{ d.theme or 'light' }}" id="b-{{ bid }}">
  <div class="wrap">
    {% if t(d.title) %}<h2 class="display-m section__title">{{ t(d.title) }}</h2>{% endif %}
    <dl class="stats">
      {% for it in d.items %}
      <div class="stats__item"><dt>{{ t(it.label) }}</dt><dd>{{ it.value }}</dd></div>
      {% endfor %}
    </dl>
  </div>
</section>
