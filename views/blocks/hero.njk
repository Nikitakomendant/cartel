<section class="hero hero--{{ d.size or 'full' }}{% if not d.image and not d.video %} hero--plain{% endif %}" id="b-{{ bid }}">
  {% if d.image or d.video %}
  <div class="hero__media">
    {{ img(d.image, {sizes: '100vw', eager: isFirst, cls: 'hero__img', alt: '', lang: lang}) }}
    {{ ui.videoTag(d.video, d.image, 'hero__video') }}
  </div>
  {% endif %}
  <div class="hero__body wrap">
    {% if isFirst %}<h1 class="hero__title">{{ t(d.title) }}</h1>{% else %}<h2 class="hero__title">{{ t(d.title) }}</h2>{% endif %}
    {% if t(d.subtitle) %}<p class="hero__sub">{{ t(d.subtitle) }}</p>{% endif %}
    {% if t(d.button_label) or t(d.button2_label) %}
    <p class="actions">{{ ui.btn(t(d.button_label), d.button_url, 'light') }}{{ ui.btn(t(d.button2_label), d.button2_url, 'ghost-light') }}</p>
    {% endif %}
  </div>
  {% if d.video and media(d.video) %}<button type="button" class="hero__pause" data-video-toggle aria-label="{{ s('common.pause') }}" data-label-play="{{ s('common.play') }}" data-label-pause="{{ s('common.pause') }}"></button>{% endif %}
</section>
