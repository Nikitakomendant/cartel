<section class="section section--{{ d.theme or 'light' }}" id="b-{{ bid }}">
  <div class="wrap split split--{{ d.position or 'right' }}">
    <div class="split__text">
      {% if t(d.title) %}<h2 class="display-m">{{ t(d.title) }}</h2>{% endif %}
      <div class="prose">{{ t(d.body) | rich }}</div>
      {% if t(d.button_label) %}<p class="actions">{{ ui.btn(t(d.button_label), d.button_url, 'ghost' if (d.theme != 'dark') else 'ghost-light') }}</p>{% endif %}
    </div>
    {% if d.image %}<figure class="split__media">{{ img(d.image, {sizes: '(min-width: 900px) 50vw, 100vw', lang: lang}) }}</figure>{% endif %}
  </div>
</section>
