{% if d.images and d.images.length %}
<section class="section" id="b-{{ bid }}">
  <div class="wrap">
    {% if t(d.title) %}<h2 class="display-m section__title">{{ t(d.title) }}</h2>{% endif %}
    <div class="gallery" data-gallery>
      {% for m in d.images %}{% set mm = media(m) %}{% if mm %}
      <button type="button" class="gallery__item{% if mm.width > mm.height * 1.3 %} gallery__item--wide{% endif %}" data-full="{{ mediaUrl(m, '2400') or mediaUrl(m, '1600') }}" aria-label="{{ t(mm.alt) or s('brand.gallery') }} {{ loop.index }}">
        {{ img(m, {sizes: '(min-width: 900px) 33vw, 50vw', lang: lang}) }}
      </button>
      {% endif %}{% endfor %}
    </div>
  </div>
</section>
{% endif %}
