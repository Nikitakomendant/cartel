{% set evs = data.events() %}
{% if evs.length %}
<section class="section section--dark" id="events">
  <div class="wrap">
    <div class="section__head">
      {% if t(d.title) %}<h2 class="display-m">{{ t(d.title) }}</h2>{% endif %}
      {% if t(d.intro) %}<p class="lead">{{ t(d.intro) }}</p>{% endif %}
    </div>
    <ul class="events">
      {% for e in evs %}
      <li class="event">
        <div class="event__media" data-gallery>
          {% if e.cover %}<button type="button" class="event__cover" data-full="{{ mediaUrl(e.cover, '2400') or mediaUrl(e.cover, '1600') }}" aria-label="{{ t(e.title) }}">{{ img(e.cover, {sizes: '(min-width: 900px) 50vw, 100vw', alt: t(e.title), lang: lang}) }}</button>{% endif %}
          {% for ph in e.photos %}{% if loop.index <= 6 %}<button type="button" class="event__thumb" data-full="{{ mediaUrl(ph, '2400') or mediaUrl(ph, '1600') }}" aria-label="{{ t(e.title) }} {{ loop.index + 1 }}">{{ img(ph, {sizes: '120px', alt: '', lang: lang}) }}</button>{% endif %}{% endfor %}
        </div>
        <div class="event__body">
          {% if t(e.date) %}<p class="event__date">{{ t(e.date) }}</p>{% endif %}
          <h3 class="display-s">{{ t(e.title) }}</h3>
          {% if t(e.caption) %}<p>{{ t(e.caption) }}</p>{% endif %}
          {% if e.video and media(e.video) %}{{ ui.videoTag(e.video, e.cover, 'event__video', true) }}
          {% elif embedUrl(e.embed) %}<div class="video__embed video__embed--small" data-embed="{{ embedUrl(e.embed) }}"><button type="button" class="video__play" data-embed-play><span>{{ s('common.play') }}</span></button></div>{% endif %}
        </div>
      </li>
      {% endfor %}
    </ul>
  </div>
</section>
{% endif %}
