{% extends "layout.njk" %}
{% import "partials/macros.njk" as ui with context %}
{% block bodyclass %}page-project{% endblock %}
{% block main %}
{% set p = project %}
<section class="hero hero--full">
  <div class="hero__media">
    {{ img(p.image, {sizes: '100vw', eager: true, cls: 'hero__img', alt: '', lang: lang}) }}
    {{ ui.videoTag(p.video, p.image, 'hero__video') }}
  </div>
  <div class="hero__body wrap">
    <nav class="crumbs" aria-label="Breadcrumbs"><a href="{{ lp('/investments') }}">{{ s('nav.investments') }}</a></nav>
    <h1 class="hero__title">{{ t(p.title) }}{% if t(p.subtitle) %}<span class="hero__title-sub">{{ t(p.subtitle) }}</span>{% endif %}</h1>
    {% if t(p.short) %}<p class="hero__sub">{{ t(p.short) }}</p>{% endif %}
    <p class="actions">{{ ui.btn(t(p.button_label) or s('project.visit'), p.external_url, 'light') }}</p>
  </div>
</section>
{% include "partials/blocks.njk" %}
{% if p.external_url | safeurl %}
<section class="cta">
  <div class="wrap cta__body">
    <h2 class="display-m">{{ t(p.title) }}</h2>
    <p class="actions">{{ ui.btn(t(p.button_label) or s('project.visit'), p.external_url, 'light') }}</p>
  </div>
</section>
{% endif %}
{% endblock %}
