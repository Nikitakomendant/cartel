{% extends "layout.njk" %}
{% import "partials/forms.njk" as forms with context %}
{% block bodyclass %}page-vacancy{% endblock %}
{% block main %}
{% set v = vacancy %}
<article class="job-page wrap">
  <header class="job-page__head">
    <nav class="crumbs crumbs--dark" aria-label="Breadcrumbs"><a href="{{ lp('/vacancies') }}#vacancies">{{ s('vac.all') }}</a></nav>
    <h1 class="display-l">{{ t(v.title) }}</h1>
    <dl class="job-page__meta">
      {% if t(v.location) %}<div><dt>{{ s('vac.location') }}</dt><dd>{{ t(v.location) }}{% if brand %}, <a href="{{ brand.url }}">{{ t(brand.name) }}</a>{% endif %}</dd></div>{% endif %}
      {% if t(v.employment) %}<div><dt>{{ s('vac.employment') }}</dt><dd>{{ t(v.employment) }}</dd></div>{% endif %}
      {% if t(v.salary) %}<div><dt>{{ s('vac.salary') }}</dt><dd>{{ t(v.salary) }}</dd></div>{% endif %}
    </dl>
    <p class="actions"><a class="btn btn--primary" href="#form">{{ s('vac.apply') }}</a>{% if hr.phone %} <a class="btn btn--ghost" href="{{ hr.phone | tel }}">{{ hr.phone }}</a>{% endif %}</p>
  </header>
  <div class="job-page__body">
    {% if t(v.summary) %}<p class="lead">{{ t(v.summary) }}</p>{% endif %}
    {% if t(v.duties) %}<section><h2 class="display-s">{{ s('vac.duties') }}</h2><div class="prose">{{ t(v.duties) | rich }}</div></section>{% endif %}
    {% if t(v.requirements) %}<section><h2 class="display-s">{{ s('vac.requirements') }}</h2><div class="prose">{{ t(v.requirements) | rich }}</div></section>{% endif %}
    {% if t(v.conditions) %}<section><h2 class="display-s">{{ s('vac.conditions') }}</h2><div class="prose">{{ t(v.conditions) | rich }}</div></section>{% endif %}
  </div>
  <aside class="job-page__aside">
    <div class="apply-box" id="form">
      <h2 class="display-s">{{ s('vac.form_title') }}</h2>
      {{ forms.apply(v.id, 'v') }}
    </div>
    <ul class="recruiter-mini">
      {% if hr.phone %}<li><a href="{{ hr.phone | tel }}">{{ hr.phone }}</a></li>{% endif %}
      {% if hr.telegram | safeurl %}<li><a href="{{ hr.telegram | safeurl }}" target="_blank" rel="noopener">Telegram</a></li>{% endif %}
      {% if hr.viber %}<li><a href="viber://chat?number={{ hr.viber | replace(r/[^\d+]/g, '') | replace('+', '%2B') }}">Viber</a></li>{% endif %}
      {% if hr.instagram | safeurl %}<li><a href="{{ hr.instagram | safeurl }}" target="_blank" rel="noopener">Instagram</a></li>{% endif %}
    </ul>
  </aside>
</article>
{% endblock %}
