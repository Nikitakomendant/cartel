{% extends "layout.njk" %}
{% import "partials/macros.njk" as ui with context %}
{% block bodyclass %}page-brand cat-{{ brand.category }}{% endblock %}
{% block main %}
{% set b = brand %}
{% set isHotel = b.category == 'hotel' or b.category == 'spa' %}
<section class="hero hero--tall{% if not b.hero and not b.hero_video %} hero--plain{% endif %}">
  {% if b.hero or b.hero_video %}
  <div class="hero__media">
    {{ img(b.hero, {sizes: '100vw', eager: true, cls: 'hero__img', alt: '', lang: lang}) }}
    {{ ui.videoTag(b.hero_video, b.hero, 'hero__video') }}
  </div>
  {% endif %}
  <div class="hero__body wrap">
    <nav class="crumbs" aria-label="Breadcrumbs"><a href="{{ lp('/brands') }}">{{ s('nav.brands') }}</a> <span aria-hidden="true">/</span> <a href="{{ lp('/brands') }}?c={{ b.category }}">{{ s('cat.' + b.category) }}</a></nav>
    {% if b.logo %}<div class="hero__logo">{{ img(b.logo, {sizes: '200px', alt: t(b.name), lang: lang}) }}</div>{% endif %}
    <h1 class="hero__title{% if b.logo %} sr-only{% endif %}">{{ t(b.name) }}</h1>
    {% if t(b.tagline) %}<p class="hero__sub">{{ t(b.tagline) }}</p>{% endif %}
    {% if t(b.notice) %}<p class="badge badge--light">{{ t(b.notice) }}</p>{% endif %}
    <p class="actions">
      {% set bookHref = (b.booking_url | safeurl) or ((b.reception_phone or b.phones[0]) | tel if (b.reception_phone or b.phones.length) else '') %}
      {% if bookHref %}{{ ui.btn(s('brand.book') if isHotel else s('brand.book_table'), bookHref, 'light') }}{% endif %}
      {% if b.menu_url | safeurl %}{{ ui.btn(s('brand.menu'), b.menu_url, 'ghost-light') }}{% endif %}
      {% if b.website | safeurl %}{{ ui.btn(s('brand.website'), b.website, 'ghost-light') }}{% endif %}
    </p>
  </div>
</section>

{% if t(b.description) or (b.show_info !== false and (b.info.length or t(b.hours))) %}
<section class="section">
  <div class="wrap brand-intro">
    <div class="prose prose--lead">{{ t(b.description) | rich }}</div>
    {% if b.show_info !== false and (b.info.length or t(b.hours)) %}
    <aside class="facts" aria-label="{{ s('brand.info') }}">
      <h2 class="facts__title">{{ s('brand.info') }}</h2>
      <dl>
        {% for it in b.info %}{% if t(it.label) %}<div><dt>{{ t(it.label) }}</dt><dd>{{ t(it.value) }}</dd></div>{% endif %}{% endfor %}
        {% if t(b.hours) %}<div><dt>{{ s('brand.hours') }}</dt><dd>{{ t(b.hours) }}</dd></div>{% endif %}
      </dl>
    </aside>
    {% endif %}
  </div>
</section>
{% endif %}

{% if b.show_gallery !== false and b.gallery and b.gallery.length %}
<section class="section section--flush" aria-label="{{ s('brand.gallery') }}">
  <div class="wrap">
    <div class="gallery" data-gallery>
      {% for m in b.gallery %}{% set mm = media(m) %}{% if mm %}
      <button type="button" class="gallery__item{% if mm.width > mm.height * 1.3 %} gallery__item--wide{% endif %}" data-full="{{ mediaUrl(m, '2400') or mediaUrl(m, '1600') }}" aria-label="{{ s('brand.gallery') }} {{ loop.index }}">{{ img(m, {sizes: '(min-width: 900px) 33vw, 50vw', lang: lang}) }}</button>
      {% endif %}{% endfor %}
    </div>
  </div>
</section>
{% endif %}

{% include "partials/blocks.njk" %}

{% set hasContacts = b.show_contacts !== false and (b.phones.length or b.reception_phone or b.email) %}
{% set hasMap = b.show_map !== false and (t(b.address) or b.geo) %}
{% set hasSocial = b.show_social !== false and (b.instagram or b.facebook or b.tiktok or b.youtube or b.telegram) %}
{% if hasContacts or hasMap or hasSocial or b.links.length %}
<section class="section section--tint" id="contacts">
  <div class="wrap visit">
    <div class="visit__info">
      <h2 class="display-m">{{ s('brand.contacts') }}</h2>
      <dl class="visit__list">
        {% if hasMap and t(b.address) %}<div><dt>{{ s('brand.address') }}</dt><dd>{{ t(b.address) }}{% set gmap = b.map_url | safeurl %}{% if not gmap and b.geo %}{% set gmap = 'https://www.google.com/maps/search/?api=1&query=' + b.geo.lat + ',' + b.geo.lng %}{% endif %}{% if gmap %}<br><a href="{{ gmap }}" target="_blank" rel="noopener">{{ s('brand.open_map') }}</a>{% endif %}</dd></div>{% endif %}
        {% if b.show_info === false and t(b.hours) %}<div><dt>{{ s('brand.hours') }}</dt><dd>{{ t(b.hours) }}</dd></div>{% endif %}
        {% if hasContacts %}
          {% if b.reception_phone %}<div><dt>{{ s('brand.reception') }}</dt><dd><a class="big-link" href="{{ b.reception_phone | tel }}">{{ b.reception_phone }}</a></dd></div>{% endif %}
          {% if b.phones.length %}<div><dt>{{ s('common.phone') }}</dt><dd>{% for ph in b.phones %}<a class="big-link" href="{{ ph | tel }}">{{ ph }}</a>{% if not loop.last %}<br>{% endif %}{% endfor %}</dd></div>{% endif %}
          {% if b.email %}<div><dt>{{ s('common.email') }}</dt><dd><a href="mailto:{{ b.email }}">{{ b.email }}</a></dd></div>{% endif %}
        {% endif %}
        {% if hasSocial %}<div><dt>{{ s('brand.social') }}</dt><dd>{{ ui.socials(b, 'socials--inline') }}</dd></div>{% endif %}
        {% if b.links.length %}<div><dt>&nbsp;</dt><dd class="visit__links">{% for l in b.links %}{% if l.url | safeurl %}<a href="{{ l.url | safeurl }}"{% if l.url | isExternal %} target="_blank" rel="noopener"{% endif %}>{{ t(l.label) or (l.url | host) }}</a>{% endif %}{% endfor %}</dd></div>{% endif %}
      </dl>
      {% if b.booking_url | safeurl %}<p class="actions">{{ ui.btn(s('brand.book') if isHotel else s('brand.book_table'), b.booking_url, 'primary') }}</p>{% endif %}
    </div>
    {% if hasMap and b.geo %}
    <div class="map map--single" data-map data-points="{{ [{lat: b.geo.lat, lng: b.geo.lng, name: t(b.name), cat: b.category, address: t(b.address)}] | jsonattr }}" data-zoom="15" role="region" aria-label="{{ s('brand.address') }}"></div>
    {% endif %}
  </div>
</section>
{% endif %}

{% if related.length %}
<section class="section">
  <div class="wrap">
    <div class="section__head section__head--row">
      <h2 class="display-s">{{ s('cat.' + b.category) }}</h2>
      <a class="arrow-link" href="{{ lp('/brands') }}?c={{ b.category }}">{{ s('brand.all') }}</a>
    </div>
    <ul class="catalog__grid catalog__grid--3" role="list">
      {% for r in related %}
      <li class="brand-card"><a href="{{ r.url }}">
        <div class="brand-card__media">{% if r.cardImage %}{{ img(r.cardImage, {sizes: '(min-width: 900px) 33vw, 100vw', alt: '', lang: lang}) }}{% else %}<span class="brand-card__placeholder">{{ t(r.name) }}</span>{% endif %}</div>
        <h3 class="brand-card__name">{{ t(r.name) }}</h3>
        <p class="brand-card__meta">{{ t(r.city) }}</p>
      </a></li>
      {% endfor %}
    </ul>
  </div>
</section>
{% endif %}
{% endblock %}
