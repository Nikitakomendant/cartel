{% macro btn(label, url, style='primary', extra='') %}
{% set u = url | safeurl %}
{% if label and u %}<a class="btn btn--{{ style }}" href="{{ u }}"{% if u | isExternal %} target="_blank" rel="noopener"{% endif %}{{ extra | safe }}>{{ label }}</a>{% endif %}
{% endmacro %}

{% macro socials(o, cls='') %}
{% set names = {instagram: 'Instagram', facebook: 'Facebook', youtube: 'YouTube', tiktok: 'TikTok', telegram: 'Telegram', linkedin: 'LinkedIn', viber: 'Viber'} %}
<ul class="socials {{ cls }}">
{% for k, label in names %}{% set u = o[k] | safeurl %}{% if u %}<li><a href="{{ u }}" target="_blank" rel="noopener">{{ label }}</a></li>{% endif %}{% endfor %}
</ul>
{% endmacro %}

{% macro heading(text, level=2, cls='') %}
{% if text %}<h{{ level }} class="{{ cls }}">{{ text }}</h{{ level }}>{% endif %}
{% endmacro %}

{% macro videoTag(id, poster, cls='', controls=false) %}
{% set m = media(id) %}
{% if m and m.kind == 'video' %}
<video class="{{ cls }}" {% if controls %}controls preload="metadata"{% else %}autoplay muted loop playsinline preload="metadata" data-autoplay{% endif %}{% if poster %} poster="{{ mediaUrl(poster, '1600') }}"{% endif %}>
  <source src="/media/{{ m.file }}" type="{{ m.mime }}">
</video>
{% endif %}
{% endmacro %}

{% macro field(name, label, type='text', required=false, autocomplete='', hint='', attrs='', uid='x') %}
<div class="field" data-field="{{ name }}">
  <label for="f-{{ name }}-{{ uid }}">{{ label }}{% if required %}<span class="req" aria-hidden="true"> *</span>{% endif %}</label>
  {% if type == 'textarea' %}
  <textarea id="f-{{ name }}-{{ uid }}" name="{{ name }}" rows="5" maxlength="5000"{% if required %} required{% endif %} {{ attrs | safe }}></textarea>
  {% else %}
  <input id="f-{{ name }}-{{ uid }}" name="{{ name }}" type="{{ type }}"{% if autocomplete %} autocomplete="{{ autocomplete }}"{% endif %}{% if required %} required{% endif %} maxlength="300" {{ attrs | safe }}>
  {% endif %}
  {% if hint %}<p class="field__hint">{{ hint }}</p>{% endif %}
  <p class="field__error" role="alert" hidden></p>
</div>
{% endmacro %}

{% macro formMeta(form, lang, token, turnstileKey) %}
<input type="hidden" name="_token" value="{{ token }}">
<input type="hidden" name="lang" value="{{ lang }}">
<div class="hp" aria-hidden="true"><label>Website <input type="text" name="website_url" tabindex="-1" autocomplete="off"></label></div>
{% if turnstileKey %}<div class="cf-turnstile" data-sitekey="{{ turnstileKey }}" data-language="{{ lang }}"></div>{% endif %}
{% endmacro %}
