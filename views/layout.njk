{% import "partials/macros.njk" as ui with context %}<!DOCTYPE html>
<html lang="{{ lang }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{{ meta.title }}</title>
{% if meta.description %}<meta name="description" content="{{ meta.description }}">{% endif %}
{% if meta.noindex %}<meta name="robots" content="noindex, nofollow">{% endif %}
{% if canonical %}<link rel="canonical" href="{{ canonical }}">{% endif %}
{% for a in alternates %}<link rel="alternate" hreflang="{{ a.code }}" href="{{ a.href }}">
{% endfor %}{% if alternates %}<link rel="alternate" hreflang="x-default" href="{{ alternates[0].href }}">{% endif %}
<meta property="og:site_name" content="CARTEL">
<meta property="og:type" content="{{ meta.type or 'website' }}">
<meta property="og:title" content="{{ meta.title }}">
{% if meta.description %}<meta property="og:description" content="{{ meta.description }}">{% endif %}
{% if canonical %}<meta property="og:url" content="{{ canonical }}">{% endif %}
<meta property="og:locale" content="{{ 'uk_UA' if lang == 'uk' else 'en_US' }}">
{% if meta.image %}<meta property="og:image" content="{{ baseUrl }}{{ meta.image }}"><meta property="og:image:width" content="1200"><meta property="og:image:height" content="630">{% else %}<meta property="og:image" content="{{ baseUrl }}/static/img/og-default.jpg">{% endif %}
<meta name="twitter:card" content="summary_large_image">
{% if analytics and analytics.google_verification %}<meta name="google-site-verification" content="{{ analytics.google_verification }}">{% endif %}
<meta name="theme-color" content="#13231e">
<link rel="icon" href="/static/img/favicon.svg" type="image/svg+xml">
<link rel="icon" href="/favicon.ico" sizes="32x32">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="manifest" href="/site.webmanifest">
<link rel="preload" href="/static/fonts/cormorant-garamond-cyrillic-400-normal.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/static/fonts/manrope-cyrillic-400-normal.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/static/css/site.css?v={{ v }}">
{% block head %}{% endblock %}
{% if meta.jsonld %}<script type="application/ld+json" nonce="{{ nonce }}">{{ meta.jsonld | json }}</script>{% endif %}
{% if analytics and (analytics.gtm_id or analytics.ga4_id or analytics.pixel_id) and not preview %}
<script nonce="{{ nonce }}" id="analytics-config" type="application/json">{{ {gtm: analytics.gtm_id, ga4: analytics.ga4_id, pixel: analytics.pixel_id, banner: analytics.cookie_banner !== false} | json }}</script>
<script nonce="{{ nonce }}" src="/static/js/analytics.js?v={{ v }}"></script>
{% endif %}
</head>
<body class="{% block bodyclass %}{% endblock %}{% if firstHero %} has-hero{% endif %}">
<a class="skip" href="#main">{{ s('nav.skip') }}</a>
{% if preview %}<div class="preview-bar" role="status">Попередній перегляд чернетки — відвідувачі бачать опубліковану версію. <a href="{{ adminPath }}">Повернутися в CMS</a></div>{% endif %}

<header class="site-header" data-header>
  <div class="wrap site-header__inner">
    <a href="{{ lp('/') }}" class="logo" aria-label="{{ s('nav.home') }}">CARTEL</a>
    <nav class="site-nav" aria-label="{{ s('nav.menu') }}">
      <ul>
        {% for n in nav %}<li><a href="{{ n.href }}"{% if n.active %} aria-current="page"{% endif %}>{{ n.label }}</a></li>{% endfor %}
      </ul>
    </nav>
    <div class="site-header__tools">
      <div class="lang" role="group" aria-label="{{ s('common.lang') }}">
        {% for l in langs %}<a href="{{ l.href }}" hreflang="{{ l.code }}" lang="{{ l.code }}"{% if l.active %} aria-current="true"{% endif %}>{{ l.short or l.code | upper }}</a>{% endfor %}
      </div>
      <button class="menu-btn" type="button" aria-expanded="false" aria-controls="mobile-nav" data-menu-btn>
        <span class="menu-btn__label">{{ s('nav.menu') }}</span>
      </button>
    </div>
  </div>
</header>
<div class="mobile-nav" id="mobile-nav" hidden data-mobile-nav>
  <nav aria-label="{{ s('nav.menu') }}">
    <ul>
      {% for n in nav %}<li><a href="{{ n.href }}"{% if n.active %} aria-current="page"{% endif %}>{{ n.label }}</a></li>{% endfor %}
    </ul>
  </nav>
  <div class="mobile-nav__foot">
    {% set p0 = company.phones[0] if company.phones else null %}
    {% if p0 %}<a href="{{ p0.number | tel }}">{{ p0.number }}</a>{% endif %}
    <div class="lang">{% for l in langs %}<a href="{{ l.href }}" hreflang="{{ l.code }}"{% if l.active %} aria-current="true"{% endif %}>{{ l.name }}</a>{% endfor %}</div>
  </div>
</div>

<main id="main" tabindex="-1">
{% block main %}{% endblock %}
</main>

<footer class="site-footer">
  <div class="wrap">
    <div class="site-footer__top">
      <div class="site-footer__brand">
        <a href="{{ lp('/') }}" class="logo logo--lg" aria-label="{{ s('nav.home') }}">CARTEL</a>
        {% if company.footer_text %}<p>{{ t(company.footer_text) }}</p>{% endif %}
      </div>
      <nav class="site-footer__col" aria-label="{{ s('footer.nav') }}">
        <h2>{{ s('footer.nav') }}</h2>
        <ul>{% for n in nav %}<li><a href="{{ n.href }}">{{ n.label }}</a></li>{% endfor %}</ul>
      </nav>
      <div class="site-footer__col">
        <h2>{{ s('footer.contacts') }}</h2>
        <ul>
          {% for p in company.phones %}<li><a href="{{ p.number | tel }}">{{ p.number }}</a>{% if t(p.label) %} <span class="muted">{{ t(p.label) }}</span>{% endif %}</li>{% endfor %}
          {% for e in company.emails %}{% if loop.index <= 2 %}<li><a href="mailto:{{ e.email }}">{{ e.email }}</a></li>{% endif %}{% endfor %}
          {% if t(company.address) %}<li class="muted">{{ t(company.address) }}</li>{% endif %}
        </ul>
      </div>
      <div class="site-footer__col">
        <h2>{{ s('footer.social') }}</h2>
        {{ ui.socials(social) }}
      </div>
    </div>
    <div class="site-footer__legal">
      <p>© {{ t(company.legal_name) or 'CARTEL' }}, {{ company.since or '2004' }}–{{ year() }}{% if t(company.legal_text) %}. {{ t(company.legal_text) }}{% endif %}</p>
      <p><a href="{{ lp('/privacy') }}">{{ s('footer.privacy') }}</a>{% if analytics and analytics.cookie_banner !== false and (analytics.gtm_id or analytics.ga4_id or analytics.pixel_id) %} · <button type="button" class="linklike" data-cookie-settings>{{ s('footer.cookies') }}</button>{% endif %}{% if not preview %} · <a href="{{ adminUrl or adminPath }}" rel="nofollow">{{ 'Staff login' if lang == 'en' else 'Для працівників' }}</a>{% endif %}</p>
    </div>
  </div>
</footer>

{% if analytics and analytics.cookie_banner !== false and (analytics.gtm_id or analytics.ga4_id or analytics.pixel_id) and not preview %}
<div class="cookie" role="dialog" aria-live="polite" aria-label="Cookies" hidden data-cookie>
  <p>{{ s('cookie.text') }} <a href="{{ lp('/privacy') }}">{{ s('footer.privacy') }}</a></p>
  <div class="cookie__actions">
    <button type="button" class="btn btn--ghost btn--sm" data-consent="denied">{{ s('cookie.decline') }}</button>
    <button type="button" class="btn btn--primary btn--sm" data-consent="granted">{{ s('cookie.accept') }}</button>
  </div>
</div>
{% endif %}
<script nonce="{{ nonce }}" id="i18n" type="application/json">{{ {sending: s('form.sending'), error: s('form.error'), required: s('form.err_required'), email: s('form.err_email'), phone: s('form.err_phone'), contact: s('form.err_contact'), consent: s('form.err_consent'), file: s('form.err_file'), prev: s('common.prev'), next: s('common.next'), close: s('nav.close'), menu: s('nav.menu'), tiles: maps.tile_url, tilesAttribution: maps.attribution} | json }}</script>
<script nonce="{{ nonce }}" src="/static/js/site.js?v={{ v }}" defer></script>
{% block scripts %}{% endblock %}
</body>
</html>
