{% extends "admin/layout.njk" %}
{% block content %}
<h1>Заявки з форм</h1>
<nav class="tabs"><a href="?"{% if not f %} aria-current="page"{% endif %}>Усі</a>{% for k, l in FORM_LABEL %}<a href="?form={{ k }}"{% if f == k %} aria-current="page"{% endif %}>{{ l }}</a>{% endfor %}</nav>
{% if not rows.length %}<div class="empty">Заявок поки немає.</div>{% else %}
<table class="table">
  <thead><tr><th>Дата</th><th>Форма</th><th>Імʼя</th><th>Контакт</th><th>Тема / напрям</th><th>Статус</th></tr></thead>
  <tbody>
  {% for r in rows %}
  <tr{% if r.status == 'new' %} class="is-new"{% endif %}>
    <td class="nowrap">{{ r.created_at | date }}</td><td>{{ FORM_LABEL[r.form] }}</td>
    <td><a href="{{ A }}/submissions/{{ r.id }}">{{ r.data.name }}</a></td><td>{{ r.data.contact }}</td>
    <td>{{ r.data.topic or ({business: 'Business', creators: 'Creators'}[r.data.direction]) or '—' }}</td>
    <td><span class="pill">{{ SUB_STATUS[r.status] }}</span></td>
  </tr>
  {% endfor %}
  </tbody>
</table>
{% endif %}
{% endblock %}
