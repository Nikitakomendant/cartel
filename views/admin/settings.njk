{% extends "admin/layout.njk" %}
{% block bodyclass %}editing{% endblock %}
{% block content %}
<div class="edit-head">
  <div>
    <h1>{{ g.label }}</h1>
    {% if g.help %}<p class="muted">{{ g.help }}</p>{% endif %}
    <p class="muted small" data-saved></p>
  </div>
  <div class="edit-head__actions">
    <div class="seg" role="group" aria-label="Мова редагування" data-lang-switch></div>
    <button class="btn btn--primary" type="button" data-save-settings>Зберегти</button>
  </div>
</div>
<div class="flash flash--err" role="alert" data-errors hidden></div>
<div class="edit-layout">
  <div id="editor" class="editor"></div>
  <aside class="edit-side">
    <section class="panel">
      <h2>Історія змін</h2>
      {% if revisions.length %}
      <ul class="list-plain small">
        {% for r in revisions %}<li>{{ r.created_at | date }} · {{ r.user_name or 'система' }}
          {% if not loop.first %}<form method="post" action="{{ A }}/settings/{{ group }}/restore/{{ r.id }}" class="inline" data-confirm="Відновити цю версію налаштувань?"><input type="hidden" name="_csrf" value="{{ csrf }}"><button class="linkbtn">відновити</button></form>{% else %}<span class="muted">(поточна)</span>{% endif %}
        </li>{% endfor %}
      </ul>
      {% else %}<p class="small muted">Змін ще не було.</p>{% endif %}
    </section>
  </aside>
</div>
<script type="application/json" id="boot" nonce="{{ nonce }}">{{ boot | json }}</script>
{% endblock %}
{% block scripts %}<script src="/static/js/editor.js?v={{ v }}" nonce="{{ nonce }}"></script>{% endblock %}
