{% extends "admin/layout.njk" %}
{% block content %}
<div class="head"><h1>Відгуки кандидатів</h1><a class="btn" href="{{ A }}/applications.csv">Експорт у CSV</a></div>
<form class="filters" method="get">
  <label class="f f--inline">Статус<select name="status"><option value="">Усі</option>{% for k, l in APP_STATUS %}<option value="{{ k }}"{% if st == k %} selected{% endif %}>{{ l }}</option>{% endfor %}</select></label>
  <label class="f f--inline">Вакансія<select name="vacancy"><option value="">Усі</option>{% for v in vacancies %}<option value="{{ v.id }}"{% if vid == v.id %} selected{% endif %}>{{ v.label }}{% if v.status != 'published' %} ({{ v.status }}){% endif %}</option>{% endfor %}</select></label>
  <label class="f f--inline">Пошук<input name="q" value="{{ q }}" placeholder="Імʼя, телефон, email"></label>
  <button class="btn">Показати</button>
</form>
{% if not rows.length %}<div class="empty">Відгуків не знайдено.</div>{% else %}
<table class="table table--click">
  <thead><tr><th>Дата</th><th>Кандидат</th><th>Вакансія</th><th>Телефон</th><th>Резюме</th><th>Статус</th></tr></thead>
  <tbody>
  {% for a in rows %}
  <tr{% if a.status == 'new' %} class="is-new"{% endif %}>
    <td class="nowrap">{{ a.created_at | date }}</td>
    <td><a href="{{ A }}/applications/{{ a.id }}">{{ a.name }}</a></td>
    <td>{{ a.vacancy_title }}</td>
    <td class="nowrap"><a href="tel:{{ a.phone | replace(r/[^\d+]/g, '') }}">{{ a.phone }}</a></td>
    <td>{% if a.cv_file %}є{% else %}<span class="muted">—</span>{% endif %}</td>
    <td><span class="pill pill--a-{{ a.status }}">{{ APP_STATUS[a.status] }}</span></td>
  </tr>
  {% endfor %}
  </tbody>
</table>
{% endif %}
{% endblock %}
