{% extends "admin/layout.njk" %}
{% block bodyclass %}editing{% endblock %}
{% block content %}
<div class="edit-head">
  <div>
    <p class="crumb"><a href="{{ A }}/c/{{ e.type }}">{{ def.label }}</a></p>
    <h1 data-title>{{ title }}</h1>
    <p class="edit-head__status"><span class="pill pill--{{ e.status }}" data-status>{{ STATUS[e.status] }}</span> <span class="pill pill--dirty" data-dirty {% if not (e.dirty and e.live) %}hidden{% endif %}>є неопубліковані зміни</span> <span class="muted small" data-saved></span></p>
  </div>
  <div class="edit-head__actions">
    <div class="seg" role="group" aria-label="Мова редагування" data-lang-switch></div>
    <button class="btn" type="button" data-save title="Ctrl+S">Зберегти чернетку</button>
    <button class="btn" type="button" data-preview>Попередній перегляд</button>
    <button class="btn btn--primary" type="button" data-publish>Опублікувати</button>
  </div>
</div>
<div class="flash flash--err" role="alert" data-errors hidden></div>
<div class="flash flash--warn" data-warnings hidden></div>

<div class="edit-layout">
  <div id="editor" class="editor"></div>
  <aside class="edit-side">
    <section class="panel">
      <h2>Публікація</h2>
      <p class="small muted">«Зберегти» — зміни бачите лише ви. «Опублікувати» — зміни зʼявляться на сайті.</p>
      {% if e.status == 'published' %}
        {% if not e.system %}
        <form method="post" action="{{ A }}/c/{{ e.type }}/{{ e.id }}/status"><input type="hidden" name="_csrf" value="{{ csrf }}">
          {% if e.type == 'vacancy' %}<button class="btn btn--sm btn--block" name="status" value="inactive">Деактивувати (зняти з сайту)</button>
          {% else %}<button class="btn btn--sm btn--block" name="status" value="hidden">Приховати з сайту</button>{% endif %}
        </form>
        {% endif %}
      {% elif e.status != 'draft' or e.live %}
        <form method="post" action="{{ A }}/c/{{ e.type }}/{{ e.id }}/status"><input type="hidden" name="_csrf" value="{{ csrf }}"><button class="btn btn--sm btn--block" name="status" value="published">Повернути на сайт</button></form>
      {% endif %}
      {% if e.type == 'vacancy' and e.status != 'archived' %}
        <form method="post" action="{{ A }}/c/vacancy/{{ e.id }}/status"><input type="hidden" name="_csrf" value="{{ csrf }}"><button class="btn btn--sm btn--block btn--quiet" name="status" value="archived">Перенести в архів</button></form>
      {% endif %}
      {% if e.live and e.dirty %}
        <form method="post" action="{{ A }}/c/{{ e.type }}/{{ e.id }}/discard" data-confirm="Скасувати всі неопубліковані зміни й повернути версію, яка зараз на сайті?"><input type="hidden" name="_csrf" value="{{ csrf }}"><button class="btn btn--sm btn--block btn--quiet">Скасувати неопубліковані зміни</button></form>
      {% endif %}
    </section>
    <section class="panel">
      <h2>Інше</h2>
      <p><a href="{{ A }}/c/{{ e.type }}/{{ e.id }}/history">Історія змін і відновлення</a></p>
      {% if not e.system %}
      <form method="post" action="{{ A }}/c/{{ e.type }}/{{ e.id }}/duplicate"><input type="hidden" name="_csrf" value="{{ csrf }}"><button class="linkbtn">Дублювати</button></form>
      <form method="post" action="{{ A }}/c/{{ e.type }}/{{ e.id }}/delete" data-confirm="Видалити назавжди? Відновити можна буде лише з історії змін."><input type="hidden" name="_csrf" value="{{ csrf }}"><button class="linkbtn linkbtn--danger">Видалити</button></form>
      {% endif %}
      {% if e.type == 'vacancy' %}<p><a href="{{ A }}/applications?vacancy={{ e.id }}">Відгуки на цю вакансію</a></p>{% endif %}
    </section>
  </aside>
</div>
<script type="application/json" id="boot" nonce="{{ nonce }}">{{ boot | json }}</script>
{% endblock %}
{% block scripts %}
<link rel="stylesheet" href="/static/vendor/leaflet/leaflet.css">
<script src="/static/vendor/leaflet/leaflet.js" nonce="{{ nonce }}"></script>
<script src="/static/js/editor.js?v={{ v }}" nonce="{{ nonce }}"></script>
{% endblock %}
