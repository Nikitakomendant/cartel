{% extends "admin/layout.njk" %}
{% block content %}
<p class="crumb"><a href="{{ A }}/applications">Відгуки кандидатів</a></p>
<div class="head">
  <h1>{{ a.name }}</h1>
  <div class="pager">{% if prev %}<a class="btn btn--sm" href="{{ A }}/applications/{{ prev.id }}">← Новіший</a>{% endif %}{% if next %}<a class="btn btn--sm" href="{{ A }}/applications/{{ next.id }}">Старіший →</a>{% endif %}</div>
</div>
<div class="edit-layout">
  <div>
    <dl class="kv panel">
      <dt>Вакансія</dt><dd>{% if vac %}<a href="{{ A }}/c/vacancy/{{ vac.id }}">{{ a.vacancy_title }}</a>{% else %}{{ a.vacancy_title }}{% endif %}</dd>
      <dt>Телефон</dt><dd><a href="tel:{{ a.phone | replace(r/[^\d+]/g, '') }}">{{ a.phone }}</a></dd>
      <dt>Email</dt><dd>{% if a.email %}<a href="mailto:{{ a.email }}">{{ a.email }}</a>{% else %}<span class="muted">не вказано</span>{% endif %}</dd>
      <dt>Отримано</dt><dd>{{ a.created_at | date }} · мова сайту {{ a.lang | upper }}</dd>
      <dt>Згода на обробку даних</dt><dd>{{ a.consent_at | date }}</dd>
      {% if a.message %}<dt>Коментар</dt><dd class="pre">{{ a.message }}</dd>{% endif %}
      <dt>Email-сповіщення</dt><dd class="small">{{ {sent: 'надіслано', not_configured: 'SMTP не налаштовано', no_recipients: 'не вказано email рекрутера'}[a.email_status] or a.email_status or 'в обробці' }}</dd>
      {% if a.pf_status and a.pf_status != 'off' %}<dt>PeopleForce</dt><dd class="small">{{ a.pf_status }}{% if a.pf_error %} — {{ a.pf_error }}{% endif %}</dd>{% endif %}
    </dl>
    {% if a.cv_file %}
    <section class="panel">
      <h2>Резюме <span class="muted small">{{ a.cv_name }} · {{ a.cv_size | filesize }}</span></h2>
      <p><a class="btn btn--sm" href="{{ A }}/applications/{{ a.id }}/cv" target="_blank" rel="noopener">Відкрити в новій вкладці</a> <a class="btn btn--sm" href="{{ A }}/applications/{{ a.id }}/cv?download=1">Завантажити</a></p>
      {% if a.cv_mime == 'application/pdf' %}<iframe class="cv-frame" src="{{ A }}/applications/{{ a.id }}/cv" title="Резюме"></iframe>
      {% elif a.cv_mime == 'image/jpeg' or a.cv_mime == 'image/png' %}<img class="cv-img" src="{{ A }}/applications/{{ a.id }}/cv" alt="Резюме">
      {% else %}<p class="muted small">Документ Word — відкриється після завантаження.</p>{% endif %}
    </section>
    {% endif %}
  </div>
  <aside class="edit-side">
    <form class="panel stack" method="post" action="{{ A }}/applications/{{ a.id }}">
      <input type="hidden" name="_csrf" value="{{ csrf }}">
      <h2>Обробка</h2>
      <label class="f">Статус<select name="status">{% for k, l in APP_STATUS %}<option value="{{ k }}"{% if a.status == k %} selected{% endif %}>{{ l }}</option>{% endfor %}</select></label>
      <label class="f">Нотатки HR (бачать лише HR)<textarea name="notes" rows="6" maxlength="5000">{{ a.notes }}</textarea></label>
      <button class="btn btn--primary">Зберегти</button>
    </form>
    <form class="panel" method="post" action="{{ A }}/applications/{{ a.id }}/delete" data-confirm="Видалити відгук і резюме назавжди? Використовуйте на запит кандидата або після завершення відбору.">
      <input type="hidden" name="_csrf" value="{{ csrf }}">
      <button class="linkbtn linkbtn--danger">Видалити дані кандидата</button>
    </form>
  </aside>
</div>
{% endblock %}
