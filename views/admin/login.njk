{% extends "admin/layout.njk" %}
{% set title = 'Вхід' %}
{% block bodyclass %}login{% endblock %}
{% block bare %}
<main class="login-box">
  <p class="side__logo">CARTEL <span>CMS</span></p>
  <h1>Вхід до системи керування</h1>
  {% if error %}<div class="flash flash--err" role="alert">{{ error }}</div>{% endif %}
  <form method="post" action="{{ A }}/login" class="stack">
    <input type="hidden" name="next" value="{{ next }}">
    <label class="f">Email<input type="email" name="email" value="{{ email }}" autocomplete="username" required autofocus maxlength="200"></label>
    <label class="f">Пароль<input type="password" name="password" autocomplete="current-password" required maxlength="300"></label>
    <button class="btn btn--primary" type="submit">Увійти</button>
  </form>
  <p class="muted small">Забули пароль? Зверніться до адміністратора — він створить тимчасовий.</p>
</main>
{% endblock %}
