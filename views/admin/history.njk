{% extends "admin/layout.njk" %}
{% block content %}
<p class="crumb"><a href="{{ A }}/c/{{ e.type }}">{{ def.label }}</a> / <a href="{{ A }}/c/{{ e.type }}/{{ e.id }}">{{ titleOf(e.type, e.data) }}</a></p>
<h1>Історія змін</h1>
<p class="muted">Кожне збереження і публікація зберігаються. «Відновити» повертає версію як чернетку — на сайті вона зʼявиться після публікації.</p>
<table class="table">
  <thead><tr><th>Коли</th><th>Хто</th><th>Дія</th><th></th></tr></thead>
  <tbody>
  {% set ACT = {create: 'Створено', save: 'Збережено чернетку', publish: 'Опубліковано', restore: 'Відновлено версію', discard: 'Скасовано чернетку'} %}
  {% for r in revs %}
  <tr><td>{{ r.created_at | date }}</td><td>{{ r.user_name or 'система' }}</td><td>{% if r.action == 'publish' %}<span class="pill pill--published">{{ ACT[r.action] }}</span>{% else %}{{ ACT[r.action] or r.action }}{% endif %}</td>
  <td class="right">{% if not loop.first %}<form method="post" action="{{ A }}/c/{{ e.type }}/{{ e.id }}/restore/{{ r.id }}" data-confirm="Відновити цю версію як чернетку?"><input type="hidden" name="_csrf" value="{{ csrf }}"><button class="btn btn--sm">Відновити</button></form>{% endif %}</td></tr>
  {% endfor %}
  </tbody>
</table>
{% endblock %}
