<!DOCTYPE html>
<html lang="uk">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<title>{{ title }} — CARTEL CMS</title>
<link rel="icon" href="/static/img/favicon.svg" type="image/svg+xml">
<link rel="stylesheet" href="/static/css/admin.css?v={{ v }}">
{% block head %}{% endblock %}
</head>
<body class="{% block bodyclass %}{% endblock %}" data-csrf="{{ csrf }}" data-admin="{{ A }}">
{% if me %}
<div class="shell">
  <aside class="side" id="side">
    <a class="side__logo" href="{{ A }}">CARTEL <span>CMS</span></a>
    <nav class="side__nav" aria-label="Розділи CMS">
      <a href="{{ A }}"{% if path == '/' %} aria-current="page"{% endif %}>Головна</a>
      {% if can('content') %}
      <p class="side__group">Контент</p>
      <a href="{{ A }}/c/page"{% if path.startsWith('/c/page') %} aria-current="page"{% endif %}>Сторінки</a>
      <a href="{{ A }}/c/brand"{% if path.startsWith('/c/brand') %} aria-current="page"{% endif %}>Бренди</a>
      <a href="{{ A }}/c/project"{% if path.startsWith('/c/project') %} aria-current="page"{% endif %}>Інвестиційні проєкти</a>
      <a href="{{ A }}/c/team"{% if path.startsWith('/c/team') %} aria-current="page"{% endif %}>Команда</a>
      <a href="{{ A }}/c/event"{% if path.startsWith('/c/event') %} aria-current="page"{% endif %}>Знакові події</a>
      <a href="{{ A }}/c/quote"{% if path.startsWith('/c/quote') %} aria-current="page"{% endif %}>Цитати</a>
      <a href="{{ A }}/c/story"{% if path.startsWith('/c/story') %} aria-current="page"{% endif %}>Історії працівників</a>
      {% endif %}
      {% if can('media') %}<a href="{{ A }}/media"{% if path.startsWith('/media') %} aria-current="page"{% endif %}>Медіатека</a>{% endif %}
      {% if can('vacancies') or can('applications') %}
      <p class="side__group">HR</p>
      {% if can('vacancies') %}<a href="{{ A }}/c/vacancy"{% if path.startsWith('/c/vacancy') %} aria-current="page"{% endif %}>Вакансії</a>{% endif %}
      {% if can('applications') %}<a href="{{ A }}/applications"{% if path.startsWith('/applications') %} aria-current="page"{% endif %}>Відгуки кандидатів</a>{% endif %}
      {% if can('hr_contacts') %}<a href="{{ A }}/settings/hr"{% if path == '/settings/hr' %} aria-current="page"{% endif %}>Контакти рекрутера</a>{% endif %}
      {% endif %}
      {% if can('submissions') %}
      <p class="side__group">Заявки</p>
      <a href="{{ A }}/submissions"{% if path.startsWith('/submissions') %} aria-current="page"{% endif %}>Співпраця й контакти</a>
      {% endif %}
      {% if can('contacts') or can('seo') or can('strings') %}
      <p class="side__group">Налаштування</p>
      {% if can('contacts') %}<a href="{{ A }}/settings/company"{% if path == '/settings/company' %} aria-current="page"{% endif %}>Контакти компанії</a>
      <a href="{{ A }}/settings/social"{% if path == '/settings/social' %} aria-current="page"{% endif %}>Соцмережі</a>{% endif %}
      {% if can('strings') %}<a href="{{ A }}/strings"{% if path == '/strings' %} aria-current="page"{% endif %}>Тексти інтерфейсу</a>{% endif %}
      {% if can('seo') %}<a href="{{ A }}/settings/seo"{% if path == '/settings/seo' %} aria-current="page"{% endif %}>SEO</a>{% endif %}
      {% if can('redirects') %}<a href="{{ A }}/redirects"{% if path == '/redirects' %} aria-current="page"{% endif %}>Перенаправлення</a>{% endif %}
      {% endif %}
      {% if can('*') %}
      <p class="side__group">Адміністрування</p>
      <a href="{{ A }}/settings/forms"{% if path == '/settings/forms' %} aria-current="page"{% endif %}>Форми й антиспам</a>
      <a href="{{ A }}/settings/analytics"{% if path == '/settings/analytics' %} aria-current="page"{% endif %}>Аналітика</a>
      <a href="{{ A }}/settings/languages"{% if path == '/settings/languages' %} aria-current="page"{% endif %}>Мови</a>
      <a href="{{ A }}/settings/maps"{% if path == '/settings/maps' %} aria-current="page"{% endif %}>Карти</a>
      <a href="{{ A }}/users"{% if path.startsWith('/users') %} aria-current="page"{% endif %}>Користувачі</a>
      <a href="{{ A }}/audit"{% if path == '/audit' %} aria-current="page"{% endif %}>Журнал дій</a>
      <a href="{{ A }}/system"{% if path == '/system' %} aria-current="page"{% endif %}>Система</a>
      {% endif %}
    </nav>
    <div class="side__me">
      <a href="{{ A }}/account">{{ me.name }}</a>
      <span>{{ roleLabel[me.role] }}</span>
      <form method="post" action="{{ A }}/logout"><input type="hidden" name="_csrf" value="{{ csrf }}"><button class="linkbtn" type="submit">Вийти</button></form>
    </div>
  </aside>
  <div class="main">
    <header class="topbar">
      <button class="topbar__menu" type="button" data-side-toggle aria-controls="side" aria-expanded="false">Меню</button>
      <a class="topbar__site" href="/" target="_blank" rel="noopener">Відкрити сайт ↗</a>
    </header>
    {% if flash %}<div class="flash flash--ok" role="status">{{ flash }}</div>{% endif %}
    {% if flashError %}<div class="flash flash--err" role="alert">{{ flashError }}</div>{% endif %}
    <main class="content">{% block content %}{% endblock %}</main>
  </div>
</div>
{% else %}
{% block bare %}{% endblock %}
{% endif %}
<script src="/static/js/admin.js?v={{ v }}" nonce="{{ nonce }}"></script>
{% block scripts %}{% endblock %}
</body>
</html>
