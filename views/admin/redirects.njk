{% extends "admin/layout.njk" %}
{% block content %}
<h1>Перенаправлення (301)</h1>
<p class="muted">Коли адреса сторінки змінилася, додайте перенаправлення зі старої — Google перенесе позиції, а відвідувачі не побачать помилку 404.</p>
<form method="post" class="panel inline-form">
  <input type="hidden" name="_csrf" value="{{ csrf }}">
  <label class="f">Стара адреса<input name="from" required placeholder="/restorany/teppan" maxlength="300"></label>
  <label class="f">Нова адреса<input name="to" required placeholder="/brands/teppan" maxlength="500"></label>
  <label class="f">Тип<select name="code"><option value="301">Постійне (301)</option><option value="302">Тимчасове (302)</option></select></label>
  <button class="btn btn--primary">Додати</button>
</form>
<table class="table">
  <thead><tr><th>Стара адреса</th><th>Нова адреса</th><th>Тип</th><th>Переходів</th><th></th></tr></thead>
  <tbody>
  {% for r in rows %}<tr><td>{{ r.from_path }}</td><td>{{ r.to_path }}</td><td>{{ r.code }}</td><td>{{ r.hits }}</td>
  <td class="right"><form method="post" data-confirm="Видалити перенаправлення?"><input type="hidden" name="_csrf" value="{{ csrf }}"><button class="linkbtn linkbtn--danger" name="delete" value="{{ r.id }}">Видалити</button></form></td></tr>{% endfor %}
  </tbody>
</table>
{% endblock %}
