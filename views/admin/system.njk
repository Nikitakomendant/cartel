{% extends "admin/layout.njk" %}
{% block content %}
<h1>Система</h1>
{% if initialPw %}<div class="flash flash--warn">На сервері лежить файл data/INITIAL_ADMIN_PASSWORD.txt. Після зміни пароля видаліть його.</div>{% endif %}
<div class="cols">
  <section class="panel">
    <h2>Пошта</h2>
    {% if smtp %}<p>SMTP: <b>{{ smtpHost }}</b><br>Відправник: {{ from }}</p>{% else %}<p class="err">SMTP не налаштовано. Додайте SMTP_HOST, SMTP_USER, SMTP_PASS у файл .env на сервері.</p>{% endif %}
    <form method="post" action="{{ A }}/settings/test-email" class="inline-form"><input type="hidden" name="_csrf" value="{{ csrf }}">
      <label class="f">Надіслати тестовий лист на<input type="email" name="to" required value="{{ me.email }}"></label><button class="btn">Надіслати</button></form>
  </section>
  <section class="panel">
    <h2>Стан</h2>
    <ul class="list-plain small">
      <li>Адреса сайту: {{ baseUrl }}</li>
      <li>Режим: {{ 'production' if isProd else 'розробка (NODE_ENV≠production)' }}</li>
      <li>База даних: {{ dbSize | filesize }} · записів {{ counts.entries }} · медіа {{ counts.media }} · відгуків {{ counts.apps }}</li>
      <li>PeopleForce: {{ 'ключ задано' if pf else 'не підключено' }}</li>
      <li>Cloudflare Turnstile: {{ 'увімкнено' if turnstile else 'вимкнено (працюють honeypot, токен часу та ліміти)' }}</li>
    </ul>
  </section>
  <section class="panel">
    <h2>Резервні копії</h2>
    <p class="small muted">Щоденну копію робить сервер (див. інструкцію). Тут можна зробити копію бази вручну перед великими змінами.</p>
    <form method="post" action="{{ A }}/system/backup"><input type="hidden" name="_csrf" value="{{ csrf }}"><button class="btn">Зробити копію зараз</button></form>
    {% if backups.length %}<ul class="list-plain small">{% for b in backups %}<li>{{ b }}</li>{% endfor %}</ul>{% endif %}
  </section>
</div>
{% endblock %}
