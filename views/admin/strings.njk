{% extends "admin/layout.njk" %}
{% block content %}
<h1>Тексти інтерфейсу</h1>
<p class="muted">Підписи меню, кнопок і форм на сайті. Порожнє поле — використовується стандартний текст (показаний сірим).</p>
<form method="post" class="strings">
  <input type="hidden" name="_csrf" value="{{ csrf }}">
  <div class="strings__bar"><input type="search" placeholder="Знайти текст…" data-filter-rows aria-label="Пошук"><button class="btn btn--primary">Зберегти тексти</button></div>
  <table class="table">
    <thead><tr><th>Ключ</th>{% for l in langs %}<th>{{ l.name }}</th>{% endfor %}</tr></thead>
    <tbody>
    {% for r in rows %}
    <tr data-row="{{ r.k }} {% for l in langs %}{{ r.def[l.code] }} {% endfor %}">
      <td class="small muted">{{ r.k }}</td>
      {% for l in langs %}<td><input name="{{ r.k }}__{{ l.code }}" value="{{ r.val[l.code] }}" placeholder="{{ r.def[l.code] or r.def.uk }}" maxlength="400" aria-label="{{ r.k }} {{ l.code }}"></td>{% endfor %}
    </tr>
    {% endfor %}
    </tbody>
  </table>
  <button class="btn btn--primary">Зберегти тексти</button>
</form>
{% endblock %}
