{% extends "admin/layout.njk" %}
{% block content %}
<p class="crumb"><a href="{{ A }}/submissions">Заявки з форм</a></p>
<h1>{{ FORM_LABEL[r.form] }}: {{ r.data.name }}</h1>
<div class="edit-layout">
  <dl class="kv panel">
    {% set L = {name: 'Імʼя', company: 'Компанія / профіль', contact: 'Email або телефон', direction: 'Напрям', links: 'Сайт / соцмережі', proposal: 'Пропозиція', topic: 'Тема', message: 'Повідомлення'} %}
    {% for k, l in L %}{% if r.data[k] %}<dt>{{ l }}</dt><dd class="pre">{% if k == 'direction' %}{{ 'Creators & Influencers' if r.data[k] == 'creators' else 'Business Cooperation' }}{% else %}{{ r.data[k] }}{% endif %}</dd>{% endif %}{% endfor %}
    <dt>Отримано</dt><dd>{{ r.created_at | date }} · {{ r.lang | upper }}</dd>
    <dt>Email-сповіщення</dt><dd class="small">{{ {sent: 'надіслано', not_configured: 'SMTP не налаштовано', no_recipients: 'не вказано отримувача'}[r.email_status] or r.email_status }}</dd>
  </dl>
  <aside class="edit-side">
    <form class="panel stack" method="post"><input type="hidden" name="_csrf" value="{{ csrf }}">
      <label class="f">Статус<select name="status">{% for k, l in SUB_STATUS %}<option value="{{ k }}"{% if r.status == k %} selected{% endif %}>{{ l }}</option>{% endfor %}</select></label>
      <button class="btn btn--primary">Зберегти</button>
    </form>
    <form class="panel" method="post" data-confirm="Видалити заявку?"><input type="hidden" name="_csrf" value="{{ csrf }}"><input type="hidden" name="delete" value="1"><button class="linkbtn linkbtn--danger">Видалити</button></form>
  </aside>
</div>
{% endblock %}
