{% extends "admin/layout.njk" %}
{% block content %}
<div class="head">
  <h1>{{ def.label }}</h1>
  {% if type == 'page' %}
  <details class="newpage">
    <summary class="btn btn--primary">Нова сторінка</summary>
    <form method="post" action="{{ A }}/c/page/new" class="newpage__form">
      <input type="hidden" name="_csrf" value="{{ csrf }}">
      <label class="f">Назва<input name="title" required maxlength="120" placeholder="Напр. Корпоративні події"></label>
      <label class="f">Адреса (необовʼязково)<input name="slug" maxlength="70" placeholder="korporatyvni-podii"></label>
      <button class="btn btn--primary" type="submit">Створити</button>
    </form>
  </details>
  {% else %}
  <form method="post" action="{{ A }}/c/{{ type }}/new"><input type="hidden" name="_csrf" value="{{ csrf }}"><button class="btn btn--primary" type="submit">Додати {{ def.single }}</button></form>
  {% endif %}
</div>
{% if tabs %}
<nav class="tabs">{% for t in tabs %}<a href="?status={{ t.k }}"{% if filter == t.k %} aria-current="page"{% endif %}>{{ t.l }} <span class="count">{{ t.n }}</span></a>{% endfor %}</nav>
{% endif %}
{% if type == 'brand' %}<p class="muted small">Порядок у списку = порядок на сайті. Перетягніть рядок за ⋮⋮ або використайте стрілки.</p>{% endif %}
{% if not list.length %}
<div class="empty">Тут поки порожньо. {% if type == 'vacancy' and filter != 'active' %}{% else %}Натисніть «Додати {{ def.single }}».{% endif %}</div>
{% else %}
<ul class="rows" {% if def.reorder and (type != 'vacancy' or filter == 'active') %}data-sortable="{{ type }}"{% endif %}>
  {% for e in list %}
  <li class="row" data-id="{{ e.id }}">
    {% if def.reorder %}<span class="row__handle" title="Перетягніть, щоб змінити порядок" aria-hidden="true">⋮⋮</span>{% endif %}
    {% set th = thumb(e) %}
    {% if type != 'page' and type != 'vacancy' %}<span class="row__thumb">{% if th %}<img src="{{ th }}" alt="" loading="lazy">{% endif %}</span>{% endif %}
    <a class="row__main" href="{{ A }}/c/{{ type }}/{{ e.id }}">
      <strong>{{ titleOf(type, e.data) }}</strong>
      <span class="muted small">{{ sub(e) }}</span>
    </a>
    <span class="row__status">
      <span class="pill pill--{{ e.status }}">{{ STATUS[e.status] }}</span>
      {% if e.status == 'published' and e.dirty %}<span class="pill pill--dirty" title="Є збережені, але не опубліковані зміни">зміни не опубліковані</span>{% endif %}
      {% if type == 'vacancy' and appsByVacancy[e.id] %}<a class="pill" href="{{ A }}/applications?vacancy={{ e.id }}">відгуків: {{ appsByVacancy[e.id].n }}{% if appsByVacancy[e.id].nn %} ({{ appsByVacancy[e.id].nn }} нових){% endif %}</a>{% endif %}
    </span>
    <span class="row__actions">
      {% if type == 'vacancy' %}
        {% if e.status != 'published' %}<form method="post" action="{{ A }}/c/vacancy/{{ e.id }}/status"><input type="hidden" name="_csrf" value="{{ csrf }}"><input type="hidden" name="back" value="list"><button class="btn btn--sm" name="status" value="published">Опублікувати</button></form>{% endif %}
        {% if e.status == 'published' %}<form method="post" action="{{ A }}/c/vacancy/{{ e.id }}/status"><input type="hidden" name="_csrf" value="{{ csrf }}"><input type="hidden" name="back" value="list"><button class="btn btn--sm" name="status" value="inactive">Деактивувати</button></form>{% endif %}
        {% if e.status != 'archived' %}<form method="post" action="{{ A }}/c/vacancy/{{ e.id }}/status"><input type="hidden" name="_csrf" value="{{ csrf }}"><input type="hidden" name="back" value="list"><button class="btn btn--sm btn--quiet" name="status" value="archived">В архів</button></form>{% endif %}
        <form method="post" action="{{ A }}/c/vacancy/{{ e.id }}/duplicate"><input type="hidden" name="_csrf" value="{{ csrf }}"><button class="btn btn--sm btn--quiet">Дублювати</button></form>
      {% endif %}
      {% if def.reorder and (type != 'vacancy' or filter == 'active') %}
      <button type="button" class="iconbtn" data-move="-1" aria-label="Вище">↑</button><button type="button" class="iconbtn" data-move="1" aria-label="Нижче">↓</button>
      {% endif %}
    </span>
  </li>
  {% endfor %}
</ul>
{% endif %}
{% endblock %}
