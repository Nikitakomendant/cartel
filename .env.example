# ---- основне ----
NODE_ENV=production
PORT=3000
BASE_URL=https://cartel.ua
# Домени, з яких дозволено відкривати сайт (захист від підміни Host)
ALLOWED_HOSTS=cartel.ua,www.cartel.ua
# Адреса CMS. Нестандартна адреса зменшує кількість атак ботів (напр. /studio-7k2)
ADMIN_PATH=/admin
# Сайт працює за nginx/Cloudflare: 1 = один проксі перед застосунком
TRUST_PROXY=1
# Секрет для підпису токенів форм (≥32 символи). Згенерувати: openssl rand -hex 32
APP_SECRET=
# Перший адміністратор (використовується лише при першому запуску з порожньою базою)
ADMIN_EMAIL=admin@cartel.ua
ADMIN_PASSWORD=

# ---- пошта (SMTP) — для заявок і відгуків на вакансії ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
MAIL_FROM="CARTEL <no-reply@cartel.ua>"

# ---- необовʼязково ----
# Cloudflare Turnstile (невидима капча). Site key вводиться в CMS → Форми й антиспам
TURNSTILE_SECRET=
# PeopleForce: кандидати дублюються в ATS (вмикається в CMS → Контакти рекрутера)
PEOPLEFORCE_API_KEY=
PEOPLEFORCE_BASE_URL=https://app.peopleforce.io/api/public/v3
# Ліміти завантаження, МБ
MAX_IMAGE_MB=25
MAX_VIDEO_MB=200
MAX_CV_MB=10
# Для тестового сервера: заборонити індексацію
SITE_NOINDEX=0

# ---- Cloudflare / захист (див. docs/CLOUDFLARE.md) ----
# 1 = сайт доступний лише через Cloudflare (або Cloudflare Tunnel): беремо реальний IP відвідувача з CF-Connecting-IP
BEHIND_CLOUDFLARE=0
# Окремий домен для працівників (CMS відкривається лише на ньому). Додається в ALLOWED_HOSTS автоматично
# ADMIN_HOST=admin.cartel.ua
# Щоденний автоматичний бекап у data/backups (0 = вимкнути)
AUTO_BACKUP=1
